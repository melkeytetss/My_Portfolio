# Required — Resend API key for the contact form.
# Without it the form returns 503 instead of sending.
RESEND_API_KEY=

# Optional — WebSocket server URL for realtime features (live cursors, chat, presence)
# Leave empty to disable realtime features entirely
NEXT_PUBLIC_WS_URL=

# Optional — Umami analytics. Both must be set or nothing loads.
# UMAMI_DOMAIN is the full script URL of your own Umami instance.
UMAMI_DOMAIN=
UMAMI_SITE_ID=

# Optional — Google Analytics 4 measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Optional — old domain you moved away from (e.g. oldsite.com).
# When set, shows a one-time dismissible "we moved" notice. Leave empty.
NEXT_PUBLIC_LEGACY_HOST=
